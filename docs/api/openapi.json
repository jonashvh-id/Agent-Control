  "components": {
    "schemas": {
      "AgentCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Description",
            "default": ""
          },
          "provider": {
            "type": "string",
            "maxLength": 40,
            "title": "Provider",
            "default": ""
          },
          "runtime": {
            "type": "string",
            "maxLength": 80,
            "title": "Runtime",
            "default": ""
          },
          "scopes": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_-]{0,31}$"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Scopes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AgentCreate"
      },
      "AgentStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "disabled"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AgentStatus"
      },
      "ApprovalDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "denied"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ApprovalDecision"
      },
      "CredentialCreate": {
        "properties": {
          "scopes": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_-]{0,31}$"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Scopes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CredentialCreate"
      },
      "EnabledSet": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "EnabledSet"
      },
      "ExecutionProposal": {
        "properties": {
          "connector": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Connector"
          },
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "title": "Tool"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Idempotency Key"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "connector",
          "tool",
          "idempotency_key"
        ],
        "title": "ExecutionProposal"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.@-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "PolicySet": {
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Agent Id"
          },
          "connector": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Connector"
          },
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "title": "Tool"
          },
          "mode": {
            "type": "string",
            "enum": [
              "deny",
              "ask",
              "allow"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent_id",
          "connector",
          "tool",
          "mode"
        ],
        "title": "PolicySet"
      },
      "StopSet": {
        "properties": {
          "stopped": {
            "type": "boolean",
            "title": "Stopped"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stopped"
        ],
        "title": "StopSet"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

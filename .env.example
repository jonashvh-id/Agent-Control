# Documentation only; the application does not automatically load this file.
AGENT_CONTROL_DATA_DIR=/absolute/private/path/new-rust-runtime
AGENT_CONTROL_ORIGIN=http://127.0.0.1:8010
AGENT_CONTROL_SECURE_COOKIES=false
AGENT_CONTROL_EXECUTION_ENABLED=false
AGENT_CONTROL_MCP_ENABLED=true
# Optional: dedicated repository/Issues-scoped native token in a private external file.
# AGENT_CONTROL_GITHUB_REPOSITORIES=jonashvh-id/Agent-Control
# AGENT_CONTROL_GITHUB_CREDENTIAL_SOURCE=file
# AGENT_CONTROL_GITHUB_TOKEN_FILE=/absolute/private/path/github.token
# All configured connectors still initialize disabled and tools default DENY.

# Integrated Google OAuth: configure both variables, with your own Cloud Web client.
# AGENT_CONTROL_GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT.apps.googleusercontent.com
# AGENT_CONTROL_GOOGLE_OAUTH_SECRET_FILE=/absolute/private/path/google-client.secret
# Client secret only in an owned nonsymlink file, mode 0600; no user token configured.
# Callback is AGENT_CONTROL_ORIGIN/api/v1/connections/google-drive/callback.
# Use a dedicated Google account with native Reader sharing only on intended folders.
# Do not combine OAuth configuration with legacy GOOGLE_DRIVE_TOKEN_FILE/FILES.

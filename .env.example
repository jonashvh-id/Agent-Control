# Read from process environment; the app does not auto-load .env.
AGENT_CONTROL_DATA_DIR=./var
AGENT_CONTROL_ORIGIN=http://127.0.0.1:8010
AGENT_CONTROL_SECURE_COOKIES=false
AGENT_CONTROL_MCP_ENABLED=true
# Disabled by default. No tool executes until this AND connector state AND policy permit it.
AGENT_CONTROL_EXECUTION_ENABLED=false
# Optional GitHub pilot: configure a finite allowlist and an operator-owned mode 0600 token file.
# AGENT_CONTROL_GITHUB_REPOSITORIES=jonashvh-id/Agent-Control
# AGENT_CONTROL_GITHUB_CREDENTIAL_SOURCE=file
# AGENT_CONTROL_GITHUB_TOKEN_FILE=/absolute/private/path/github.token
# Local minimal demo alternative: gh-demo (restricted to jonashvh-id/Agent-Control and loopback).
# AGENT_CONTROL_GITHUB_CREDENTIAL_SOURCE=gh-demo
